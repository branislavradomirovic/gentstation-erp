# =================================================================
# GentStationAI Environment Variables Template
# Rename this file to .env and fill in the actual values.
# =================================================================

# --- Database Configuration ---
# Use "postgres" as DB_HOST when running inside Docker Compose.
# Use "localhost" when running the app locally against a local Postgres instance.
# On Hugging Face Spaces, prefer a managed Postgres URL as a secret:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gentstation
DB_USER=gentstation_user
DB_PASSWORD=change_me_for_local_dev
DB_SSLMODE=
DB_SLOW_QUERY_THRESHOLD=1.0
RUN_SCHEMA_MIGRATIONS_ON_STARTUP=1
STRICT_SCHEMA_INIT=1
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Redis Configuration ---
# Required for the Telegram Bot worker queue.
# On Hugging Face Spaces, use an external Redis URL if Telegram/worker flow is enabled.
REDIS_URL=redis://redis:6379/0

# --- AI & Ollama Configuration ---
# Base URL for the Ollama API.
# Inside Docker on macOS/Windows, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_VISION_MODEL=bakllava
OLLAMA_LOCAL_ONLY=1

# Video processing settings
VIDEO_FRAME_SAMPLES=6
VIDEO_MAX_FRAME_DIMENSION=768

# --- Telegram Bot Configuration ---
# Get these from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_URL=https://t.me/your_bot_username

# --- Email (SMTP) Configuration ---
# Used for password resets, welcome emails, and AI report notifications.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SENDER_EMAIL=your_email@gmail.com
MANAGER_EMAIL=admin@example.com

# --- Background Worker Configuration ---
# 1 = Enabled, 0 = Disabled. Keep disabled on Hugging Face MVP unless you
# provide external Redis and want Telegram/AI processing inside the Space.
APP_ENV=development
AUTO_START_BACKGROUND_WORKERS=0
AUTO_START_TELEGRAM_BOT=0
AUTO_START_AI_WORKER=0

# Resource limits for workers
AI_WORKER_MEMORY_LIMIT_MB=2048
BOT_WORKER_MEMORY_LIMIT_MB=1024

# --- Streamlit Configuration ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHERUSAGESTATS=false

# --- Internal Worker Tuning (Optional) ---
# AI_WORKER_POLL_INTERVAL_SECONDS=10
# MAX_VIDEO_SIZE_MB=300
# RATE_LIMIT_MAX_FILES=5
# HEARTBEAT_INTERVAL_SECONDS=30
