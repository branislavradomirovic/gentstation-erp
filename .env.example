# =================================================================
# GentStationAI Environment Variables Template
# Copy this file to .env for local development only.
# Keep real production values on the Ubuntu server, not in git.
# =================================================================

# --- Database Configuration ---
# Local notebook development defaults:
# - Run PostgreSQL locally or via `docker compose up -d postgres`
# - Run the Streamlit app directly on the notebook
# Ubuntu production:
# - Use the dedicated Compose examples under `deployment-handoff/vm/`
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gentstation
DB_USER=gentstation_user
DB_PASSWORD=change_me_for_local_dev
DB_SSLMODE=
DB_SLOW_QUERY_THRESHOLD=1.0
RUN_SCHEMA_MIGRATIONS_ON_STARTUP=1
STRICT_SCHEMA_INIT=1
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Redis Configuration ---
# Local notebook development defaults:
# - Run Redis locally or via `docker compose up -d redis`
REDIS_URL=redis://localhost:6379/0

# --- AI & Ollama Configuration ---
# Base URL for the Ollama API.
# If Ollama runs on the notebook, keep localhost.
# For the Dockerized AI worker on macOS/Windows, override with host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=bakllava:latest
OLLAMA_VISION_MODEL=bakllava:latest
OLLAMA_LOCAL_ONLY=1

# Video processing settings
VIDEO_FRAME_SAMPLES=6
VIDEO_MAX_FRAME_DIMENSION=768

# --- Telegram Bot Configuration ---
# Get these from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_URL=https://t.me/your_bot_username
TELEGRAM_BOT_HANDLE=your_bot_username

# --- Email (SMTP) Configuration ---
# Used for password resets, welcome emails, and AI report notifications.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SENDER_EMAIL=your_email@gmail.com
MANAGER_EMAIL=admin@example.com
APP_LOGIN_URL=http://localhost:8501
SUPPORT_RECIPIENT=support@example.com

# --- Background Worker Configuration ---
# Default local workflow:
# - run the web app on the notebook
# - run workers separately when needed, either locally or with Docker Compose profiles
APP_ENV=development
AUTO_START_BACKGROUND_WORKERS=0
AUTO_START_TELEGRAM_BOT=0
AUTO_START_AI_WORKER=0
AUTO_START_REPORT_SCHEDULER=0

# Resource limits for workers
AI_WORKER_MEMORY_LIMIT_MB=2048
BOT_WORKER_MEMORY_LIMIT_MB=1024
BOT_MODE=bot
TELEGRAM_RETRY_BASE_SECONDS=10
TELEGRAM_RETRY_MAX_SECONDS=180

# --- Streamlit Configuration ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHERUSAGESTATS=false

# --- Internal Worker Tuning (Optional) ---
AI_WORKER_POLL_INTERVAL_SECONDS=10
MAX_VIDEO_SIZE_MB=300
UPLOADS_DIR=./uploads
RATE_LIMIT_MAX_FILES=5
RATE_LIMIT_WINDOW_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=30
DB_STATUS_KEY=telegram_bot_status
QUEUE_STREAM=telegram:submissions
QUEUE_GROUP=telegram-workers
