# --- Application Configuration ---
APP_ENV=development  # development, staging, preprod, production
AUTO_START_BACKGROUND_WORKERS=0

# Canonical application URL used in password reset and activation emails.
# Required in staging, pre-production, and production. Local development may
# omit this and will fall back to http://localhost:8501/.
APP_LOGIN_URL=http://localhost:8501/
# Optional fallback if you prefer a single canonical base URL variable.
# APP_BASE_URL=http://localhost:8501/

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=change_me_db_name
DB_USER=change_me_db_user
DB_PASSWORD=change_me_for_local_dev
DB_PASS=change_me_for_local_dev
# Leave DATABASE_URL unset for local development unless you intentionally want
# to override the component settings above.
# DATABASE_URL=postgresql://change_me_db_user:change_me_for_local_dev@localhost:5432/change_me_db_name

# --- Cache & Queue (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- AI Services ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_URL=https://t.me/your_bot_name

# --- Email Service (SMTP) ---
SMTP_SERVER=smtp.gmail.com
# SMTP_HOST is also accepted for backward compatibility.
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SUPPORT_EMAIL=support@yourdomain.com

# --- Security ---
SECRET_KEY=generate_a_random_string_for_production
SESSION_SECRET=another_random_string

# --- Multi-Tenancy (Phase 2+) ---
# DEFAULT_TENANT_ID=1

# Media and evidence are persisted in PostgreSQL.
# Production-release gate: rotate all pre-production credentials before any
# public launch or real customer data usage.
