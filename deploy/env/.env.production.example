# GentStationAI production environment example
# Copy to deploy/env/.env.production on the Ubuntu server and fill real values there only.

APP_ENV=production
APP_DOMAIN=gentstation.example.com
APP_LOGIN_URL=https://gentstation.example.com

DB_NAME=gentstation
DB_USER=gentstation_user
DB_PASSWORD=replace_with_strong_database_password
DB_PORT=5432
DB_SSLMODE=

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password
INITIAL_ADMIN_EMAIL=admin@example.com

RUN_SCHEMA_MIGRATIONS_ON_STARTUP=1
STRICT_SCHEMA_INIT=1
AUTO_START_BACKGROUND_WORKERS=0
AUTO_START_TELEGRAM_BOT=0
AUTO_START_AI_WORKER=0
AUTO_START_REPORT_SCHEDULER=0
SKIP_SCHEMA_INIT=1

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=bakllava:latest
OLLAMA_VISION_MODEL=bakllava:latest
OLLAMA_LOCAL_ONLY=0
VIDEO_FRAME_SAMPLES=6
VIDEO_MAX_FRAME_DIMENSION=768
AI_WORKER_POLL_INTERVAL_SECONDS=15
AI_WORKER_EMPTY_BACKOFF_MAX_SECONDS=90
AI_WORKER_MAX_RETRIES=3
AI_WORKER_MEMORY_LIMIT_MB=2048
AI_WORKER_STUCK_TIMEOUT_SECONDS=900
REPORT_SCHEDULER_POLL_INTERVAL_SECONDS=60
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

WEB_CPU_LIMIT=1.00
WEB_MEMORY_LIMIT=1024M
WEB_MEMORY_RESERVATION=512M
AI_WORKER_CPU_LIMIT=2.00
AI_WORKER_CONTAINER_MEMORY_LIMIT=3072M
AI_WORKER_CONTAINER_MEMORY_RESERVATION=1024M
TELEGRAM_WORKER_CPU_LIMIT=0.75
TELEGRAM_WORKER_MEMORY_LIMIT=768M
TELEGRAM_WORKER_MEMORY_RESERVATION=256M
REPORT_SCHEDULER_CPU_LIMIT=0.75
REPORT_SCHEDULER_MEMORY_LIMIT=768M
REPORT_SCHEDULER_MEMORY_RESERVATION=256M
POSTGRES_CPU_LIMIT=1.50
POSTGRES_MEMORY_LIMIT=1536M
POSTGRES_MEMORY_RESERVATION=512M
REDIS_CPU_LIMIT=0.50
REDIS_MEMORY_LIMIT=512M
REDIS_MEMORY_RESERVATION=128M
REVERSE_PROXY_CPU_LIMIT=0.50
REVERSE_PROXY_MEMORY_LIMIT=512M
REVERSE_PROXY_MEMORY_RESERVATION=128M
OLLAMA_CPU_LIMIT=4.00
OLLAMA_MEMORY_LIMIT=6144M
OLLAMA_MEMORY_RESERVATION=2048M
DISK_WARN_PCT=90
QUEUE_WARN_PENDING_SUBMISSIONS=500
QUEUE_WARN_PENDING_CCTV=250
WORKER_STALE_SECONDS=180

TELEGRAM_BOT_TOKEN=replace_if_telegram_enabled
TELEGRAM_BOT_URL=https://t.me/your_bot_username
TELEGRAM_BOT_HANDLE=your_bot_username
BOT_MODE=bot
TELEGRAM_RETRY_BASE_SECONDS=10
TELEGRAM_RETRY_MAX_SECONDS=180

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=app@example.com
SMTP_PASS=replace_with_smtp_password
SENDER_EMAIL=app@example.com
MANAGER_EMAIL=manager@example.com
SUPPORT_RECIPIENT=support@example.com

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHERUSAGESTATS=false

MAX_VIDEO_SIZE_MB=300
RATE_LIMIT_MAX_FILES=5
RATE_LIMIT_WINDOW_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=30
DB_STATUS_KEY=telegram_bot_status
QUEUE_STREAM=telegram:submissions
QUEUE_GROUP=telegram-workers
